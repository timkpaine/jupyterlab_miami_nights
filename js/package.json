{
  "name": "jupyterlab_miami_nights",
  "version": "0.4.3",
  "description": "A glowing 80s theme based on Synthwave '84 and  JupyterLab's Neon Night theme by yeebc",
  "author": "the jupyterlab miami nights authors <t.paine154@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/timkpaine/jupyterlab_miami_nights.git"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlab-theme",
    "neon",
    "cyberpunk"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.css",
    "style/index.js"
  ],
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "directories": {
    "lib": "lib/"
  },
  "jupyterlab": {
    "extension": "lib/index.js",
    "themePath": "lib/index.css",
    "outputDir": "../jupyterlab_miami_nights/labextension",
    "discovery": {
      "server": {
        "base": {
          "name": "jupyterlab_miami_nights"
        },
        "managers": [
          "pip"
        ]
      }
    }
  },
  "scripts": {
    "build:babel": "babel src/ --source-maps --out-dir lib/",
    "build:css": "cpy \"style/*\" \"lib/\"",
    "build:extension": "mkdirp ../jupyterlab_miami_nights/extension/ && cpy --flat 'src/extension/*' '../jupyterlab_miami_nights/extension/'",
    "build:labextension": "rimraf ../jupyterlab_miami_nights/labextension && jupyter labextension build .",
    "build": "pnpm clean && pnpm build:babel && pnpm build:css && pnpm build:extension && pnpm build:labextension",
    "clean": "rimraf lib ../jupyterlab_miami_nights/labextension",
    "fix": "oxlint --fix src/ tests/ && oxfmt --write \"src/**/*.js\" \"tests/**/*.js\"",
    "lint": "oxlint src/ tests/ && oxfmt --check \"src/**/*.js\" \"tests/**/*.js\"",
    "preinstall": "npx only-allow pnpm",
    "prepublishOnly": "pnpm run build",
    "test": "jest --coverage --collectCoverageFrom=src/*.{js}"
  },
  "pnpm": {
    "overrides": {
      "webpack": "5.76.1"
    }
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.3",
    "@jupyterlab/apputils": "^4.7.3",
    "highlight.js": "^11.12.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@jupyterlab/builder": "^4.5.10",
    "babel-jest": "^30.5.1",
    "cpy-cli": "^7.0.0",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-junit": "^17.0.0",
    "jest-transform-css": "^6.0.3",
    "mkdirp": "^3.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rimraf": "^6.1.3"
  }
}
